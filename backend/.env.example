# Copiar este archivo como .env y completar los datos

# Servidor
PORT=3000

# MySQL (capa de datos)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=nasdaq_system

# Automatización: expresión cron (cada 15 minutos de lunes a viernes)
SYNC_CRON=*/15 * * * 1-5
# Sincronizar al arrancar el servidor (true/false)
SYNC_ON_START=true
# Histórico a descargar (1mo, 3mo, 6mo, 1y, 2y)
HISTORY_RANGE=2y
